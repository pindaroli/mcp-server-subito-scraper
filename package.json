{
  "name": "oli-II-Hands-searcher-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for custom Model Context Protocol (MCP) servers",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:mcp": "npm run test:mcp --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "build:subito": "npm run build -w mcp-server-subito-scraper",
    "dev:subito": "npm run dev -w mcp-server-subito-scraper",
    "test:subito": "npm run test -w mcp-server-subito-scraper",
    "build:vinted": "npm run build -w mcp-server-vinted-scraper",
    "dev:vinted": "npm run dev -w mcp-server-vinted-scraper",
    "test:vinted": "npm run test -w mcp-server-vinted-scraper",
    "build:wallapop": "npm run build -w mcp-server-wallapop-scraper",
    "dev:wallapop": "npm run dev -w mcp-server-wallapop-scraper",
    "test:wallapop": "npm run test -w mcp-server-wallapop-scraper"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monorepo",
    "mcp-servers"
  ],
  "author": "Olindo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
