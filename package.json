{
  "name": "mcp-server-subito-scraper",
  "version": "1.0.0",
  "description": "MCP (Model Context Protocol) server for scraping Subito.it ads using Apify Actor azzouzana/subito-scraper-pro-by-search-url",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-subito-scraper": "./dist/index.js",
    "subito-scraper-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "test": "tsx test/smoke-test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "subito",
    "subito-it",
    "scraper",
    "apify",
    "apify-actor",
    "ai",
    "claude",
    "gemini"
  ],
  "author": "Olindo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "apify-client": "^2.11.8",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olindo/mcp-server-subito-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/olindo/mcp-server-subito-scraper/issues"
  },
  "homepage": "https://github.com/olindo/mcp-server-subito-scraper#readme"
}
