# Apify API Token per Scraper Actor (Vinted, Subito.it, Wallapop)
# Ottieni il tuo token su: https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_api_token_here

# Configurazione AI Engine (Vision & Semantic Router)
# Modello multimodale ottimizzato per OCR hardware e analisi morfologica (consigliato: qwen2.5-vl:32b)
AI_VISION_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-vl:32b
AI_API_KEY=ollama
MAX_AI_INSPECTIONS=20
